[Unit]
Description=GLP Indtim Laravel queue worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/code/glp-indtim
ExecStart=/usr/bin/php /var/www/code/glp-indtim/artisan queue:work database --queue=default --sleep=3 --tries=5 --timeout=90 --max-time=3600
Restart=always
RestartSec=5
TimeoutStopSec=120
KillSignal=SIGTERM
SyslogIdentifier=glp-indtim-queue

[Install]
WantedBy=multi-user.target
